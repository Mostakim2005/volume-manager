<resources>
    <string name="app_name">Volume Manager</string>
    <string name="app_subtitle">Lightweight system volume launcher</string>

    <!-- Accessibility service -->
    <string name="accessibility_service_desc">Displays a small floating edge button that opens the system volume slider when tapped. Reads no screen content and collects no data.</string>

    <!-- Main activity -->
    <string name="card_launcher_title">System Volume Launcher</string>
