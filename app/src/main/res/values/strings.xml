    <string name="toggle_floating_button">Show floating edge button</string>
    <string name="toggle_floating_button_desc">Hide or show the edge button anytime without leaving this screen</string>
    <string name="btn_accessibility_enable">Enable Accessibility Overlay</string>
    <string name="btn_accessibility_retoggle">Re-enable Accessibility Service</string>
    <string name="btn_system_volume">Open System Volume Slider</string>
