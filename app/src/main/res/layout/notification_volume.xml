<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe widgets only: LinearLayout, ImageView, TextView, ProgressBar. Spacious & interactive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Stream Switcher Pill & Panel Expand Shortcut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Stream Switcher Pill (Clearly demarcated; tapping cycles stream without affecting volume) -->
        <LinearLayout
            android:id="@+id/notif_stream_header"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/notif_pill_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/notif_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/notif_media_down"
                android:src="@drawable/ic_volume_small" />

            <TextView
                android:id="@+id/notif_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/notif_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Quick Launch Vertical Panel Shortcut Button -->
        <TextView
            android:id="@+id/notif_btn_panel"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/notif_pill_background"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🎚️ Expand"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Minus Button | Thick 10dp Progress Track | Plus Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Volume DOWN Button -->
        <TextView
            android:id="@+id/btn_notif_down"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/notif_btn_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Centered Volume Track with Green Ball Theme -->
        <ProgressBar
            android:id="@+id/notif_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/seek_progress_green" />

        <!-- Volume UP Button -->
        <TextView
            android:id="@+id/btn_notif_up"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/notif_btn_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
