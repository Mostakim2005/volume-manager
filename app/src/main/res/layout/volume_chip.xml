<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_root"
    android:layout_width="@dimen/chip_width"
    android:layout_height="wrap_content"
    android:background="@drawable/chip_background"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:id="@+id/chip_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_stream"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/stream_music_short"
            android:textColor="#4B4B5B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zero_percent"
            android:textColor="#2C2C3A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chip_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/opt_media"
            style="@style/StreamOption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/stream_music_short" />

        <TextView
            android:id="@+id/opt_ring"
            style="@style/StreamOption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/stream_ring_short" />

        <TextView
            android:id="@+id/opt_alarm"
            style="@style/StreamOption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/stream_alarm_short" />

        <TextView
            android:id="@+id/opt_notify"
            style="@style/StreamOption"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/stream_notify_short" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <SeekBar
            android:id="@+id/chip_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:progress="5"
            android:progressDrawable="@drawable/seek_progress"
            android:thumb="@drawable/seek_thumb" />

    </FrameLayout>

</LinearLayout>
