<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/handle_root"
    android:layout_width="@dimen/handle_width"
    android:layout_height="@dimen/handle_height"
    android:background="@drawable/handle_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/handle_arrow_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▲"
        android:textColor="#E6FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/handle_icon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@string/handle_content_description"
        android:src="@drawable/ic_volume_small" />

    <TextView
        android:id="@+id/handle_arrow_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▼"
        android:textColor="#E6FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />

</LinearLayout>
