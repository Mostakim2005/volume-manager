<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe widgets only: LinearLayout, RelativeLayout, FrameLayout, TextView, ProgressBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Row 1: Active Status Pill (tap returns to Auto) & Panel Launcher -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btn_expanded_panel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="@drawable/notif_pill_background"
            android:contentDescription="@string/notif_open_panel_desc"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/notif_open_panel"
            android:textColor="@color/notif_accent_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_expanded_panel">

            <LinearLayout
                android:id="@+id/notif_expanded_header"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/notif_pill_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/notif_expanded_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/notif_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>

    <!-- Row 2: Direct 5-Profile Selector Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_stream_media"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="🎵\nMedia"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_stream_ring"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="🔔\nRing"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_stream_notify"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="💬\nNotify"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_stream_call"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="📞\nCall"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_stream_alarm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:text="⏰\nAlarm"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3: Large Minus Button | 14dp Progress Track | Large Plus Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_expanded_down"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notif_btn_background"
            android:contentDescription="@string/notif_volume_down_desc"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/notif_btn_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/notif_expanded_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/seek_progress_green" />

        <TextView
            android:id="@+id/btn_expanded_up"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notif_btn_background"
            android:contentDescription="@string/notif_volume_up_desc"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/notif_btn_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
