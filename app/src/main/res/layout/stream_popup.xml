<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stream_popup_root"
    android:layout_width="128dp"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_vertical_background"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/pop_opt_media"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/stream_option_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="🎵  Media"
        android:textColor="#FF6B3D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pop_opt_ring"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/stream_option_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="🔔  Ring"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pop_opt_notify"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/stream_option_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="💬  Notify"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pop_opt_alarm"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/stream_option_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="⏰  Alarm"
        android:textColor="#475569"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
