<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="@dimen/vertical_panel_width"
    android:layout_height="@dimen/vertical_panel_height"
    android:background="@drawable/panel_vertical_background"
    android:elevation="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <!-- Top Stream Pill Button (Tapping opens the Stream Popup) -->
    <LinearLayout
        android:id="@+id/btn_stream_icon"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:background="@drawable/stream_option_active_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/text_stream_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/text_stream_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/stream_music_short"
            android:textColor="@color/overlay_option_active_text"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vertical Volume Track (Scrubbable UP / DOWN) -->
    <FrameLayout
        android:id="@+id/vertical_track_frame"
        android:layout_width="@dimen/vertical_track_width"
        android:layout_height="@dimen/vertical_track_height"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vertical_track_background"
        android:clickable="true"
        android:focusable="true">

        <!-- Filled progress level from bottom -->
        <View
            android:id="@+id/vertical_progress_fill"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="bottom"
            android:background="@drawable/vertical_track_progress" />
    </FrameLayout>

    <!-- Percentage readout -->
    <TextView
        android:id="@+id/text_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zero_percent"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
